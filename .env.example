PORT=3003
# Official IMPIC APIBase2-V2 token (header _AcessToken). Leave empty to disable live
# enrichment, NIF fallback, and V2 incremental sync (XLSX sync still runs; no error).
# V1 /APIBase2 is discontinued on 2026-12-04.
BASE_API_KEY=
MONGO_URI=mongodb://localhost:27017/apiaberta-base

# Memory / query bounds (defaults match a small VPS with ~2.2 M contracts).
# Text search date window in days when from/to/year are omitted.
SEARCH_WINDOW_DAYS=365
# MongoDB maxTimeMS for list/count (ms).
QUERY_MAX_TIME_MS=5000
# MongoDB maxTimeMS for text search find+count (ms).
SEARCH_MAX_TIME_MS=5000
# bulkWrite batch size for V2 upserts and NIF backfill.
UPSERT_BATCH_SIZE=200
# Max numDias for a single V2 GetInfoContrato (API hard max 90). Larger gaps use XLSX.
V2_FETCH_MAX_DAYS=7
